APP_NAME="RJAY Hotspot"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite

QUEUE_CONNECTION=database

ADMIN_EMAIL=admin@rjay.local
ADMIN_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MIKROTIK_BASE_URL=http://10.10.1.1:8081/rest
MIKROTIK_USERNAME=rjay-api
MIKROTIK_PASSWORD=
MIKROTIK_VERIFY_TLS=false
MIKROTIK_HOTSPOT_SERVER=hotspot1
MIKROTIK_ADDRESS_POOL=dhcp-pool
MIKROTIK_PROFILE_PREFIX=RJAY_

SNIPPE_MODE=mock
SNIPPE_BASE_URL=https://api.snippe.sh
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_SECRET=
SNIPPE_WEBHOOK_URL=https://YOUR-PUBLIC-DOMAIN/api/webhooks/snippe
SNIPPE_TIMEOUT=20
